<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle drop shadow to mimic Chrome's omnibox lift -->
    <item
        android:top="1dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#1A000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Main pill -->
    <item>
        <shape>
            <solid android:color="?urlBarBoxColor"/>
            <stroke
                android:width="1dp"
                android:color="?urlBarBoxBorderColor"/>
            <padding
                android:left="10dp"
                android:top="4dp"
                android:right="10dp"
                android:bottom="4dp"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
