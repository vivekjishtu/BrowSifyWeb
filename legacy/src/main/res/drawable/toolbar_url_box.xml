<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <solid android:color="#0D000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?urlBarBoxColor" />
            <stroke
                android:width="1dp"
                android:color="?urlBarBoxBorderColor" />
            <padding
                android:left="10dp"
                android:top="1dp"
                android:right="10dp"
                android:bottom="1dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
