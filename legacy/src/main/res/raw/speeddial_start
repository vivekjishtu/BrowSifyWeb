<!DOCTYPE html>
<html>
<head>
    <title>New Tab</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="bsw:speeddial/base.css">
    <link rel="stylesheet" type="text/css" href="bsw:speeddial/custom.css">

    <style>
    :root {
        --bg-color: #f1f3f4;
        --text-color: #202124;
        --item-bg: white;
        --item-shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
        --search-bg: white;
        --search-border: 1px solid #dfe1e5;
        --search-shadow: 0 1px 6px rgba(32,33,36,0.28);
        --footer-text: #5f6368;
        --footer-hover: #202124;
        --footer-focus-bg: rgba(32,33,36,0.10);
        --footer-focus-border: rgba(32,33,36,0.18);
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg-color: #202124;
            --text-color: #e8eaed;
            --item-bg: #303134;
            --item-shadow: none;
            --search-bg: #303134;
            --search-border: 1px solid #5f6368;
            --search-shadow: none;
            --footer-text: #c1c6d0;
            --footer-hover: #ffffff;
            --footer-focus-bg: rgba(255,255,255,0.12);
            --footer-focus-border: rgba(255,255,255,0.22);
        }
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        text-align: center;
        margin: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
       /* min-height: 100vh; */
    }

    .search-container {
      /*  margin-top: 10vh; */
        width: 100%;
        max-width: 600px;
        margin-bottom: 40px;
    }

    #search-bar {
        width: 100%;
        padding: 16px 20px;
        border-radius: 24px;
        border: var(--search-border);
        font-size: 16px;
        box-sizing: border-box;
        background-color: var(--search-bg);
        color: var(--text-color);
        box-shadow: var(--search-shadow);
        outline: none;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        gap: 14px;
        width: 100%;
        max-width: 600px;
        padding: 0;
    }

    .grid-item {
        background-color: var(--item-bg);
        padding: 14px;
        border-radius: 16px;
        text-align: center;
        box-shadow: var(--item-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
    }

    .grid-item:active {
        transform: scale(0.95);
    }

    .grid-item a {
        text-decoration: none;
        color: var(--text-color);
        font-weight: 500;
        font-size: 12px;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .favicon {
        width: 36px;
        height: 36px;
        margin-bottom: 10px;
        border-radius: 8px;
    }


    footer {
      position: fixed;
      width: calc(100% - 20px);
      bottom: 0;
      height: 34px;
      padding: 0 8px 6px;
      text-align: right;
    }
    footer a {
      display: inline-block;
      color: var(--footer-text);
      margin: 0 2px;
      padding: 4px 9px;
      border-radius: 999px;
      text-decoration: none;
      -webkit-touch-callout: auto;
      font: caption;
      transition: background-color 0.15s ease, color 0.15s ease, outline-color 0.15s ease;
    }
    footer a:hover {
      color: var(--footer-hover);
    }
    footer a:focus,
    footer a:focus-visible,
    footer a:active {
      color: var(--footer-hover);
      background-color: var(--footer-focus-bg);
      outline: 1px solid var(--footer-focus-border);
      outline-offset: 1px;
    }
    </style>

</head>
<body>
   <div class="browserName">
       <div class="logo-wrap">
         <span class="brand-name">{{APP_NAME}}</span>
       </div>

       <style>
         .logo-wrap {
           display: inline-block;
           font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
           font-size: 34px;
           letter-spacing: -1.5px;
           padding: 8px 10px 6px;
           user-select: none;
         }

         .brand-name {
           /* Color is controlled by the active theme / dark mode */
         }
       </style>
   </div>
   <div class="search-container">
        <a href="bsw:search" id="searchBox">
            <input type="text" id="search-bar" placeholder="Search or type URL">
        </a>
    </div>
    <div class="grid-container">
