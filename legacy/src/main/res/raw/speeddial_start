<!DOCTYPE html>
<html>
<head>
    <title>New Tab</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="bsw:speeddial/base.css">
    <link rel="stylesheet" type="text/css" href="bsw:speeddial/custom.css">

    <style>
     :root {
        --bg-color: #f1f3f4;
        --text-color: #202124;
        --item-bg: white;
        --item-shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
        --search-bg: white;
        --search-border: 1px solid #dfe1e5;
        --search-shadow: 0 1px 6px rgba(32,33,36,0.28);
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg-color: #202124;
            --text-color: #e8eaed;
            --item-bg: #303134;
            --item-shadow: none;
            --search-bg: #303134;
            --search-border: 1px solid #5f6368;
            --search-shadow: none;
        }
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        text-align: center;
        margin: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
       /* min-height: 100vh; */
    }

    .search-container {
      /*  margin-top: 10vh; */
        width: 100%;
        max-width: 600px;
        margin-bottom: 40px;
    }

    #search-bar {
        width: 100%;
        padding: 16px 20px;
        border-radius: 24px;
        border: var(--search-border);
        font-size: 16px;
        box-sizing: border-box;
        background-color: var(--search-bg);
        color: var(--text-color);
        box-shadow: var(--search-shadow);
        outline: none;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        gap: 16px;
        width: 100%;
        max-width: 600px;
        padding: 0;
    }

    .grid-item {
        background-color: var(--item-bg);
        padding: 16px;
        border-radius: 8px;
        text-align: center;
        box-shadow: var(--item-shadow);
        transition: transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
    }

    .grid-item:active {
        transform: scale(0.95);
    }

    .grid-item a {
        text-decoration: none;
        color: var(--text-color);
        font-weight: 500;
        font-size: 12px;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .favicon {
        width: 32px;
        height: 32px;
        margin-bottom: 8px;
        border-radius: 4px;
    }


    footer {
      position: fixed;
      width: calc(100% - 20px);
      bottom: 0;
      height: 30px;
      padding: 0 10px 5px;
      text-align: right;
    }
    footer a {
      color: #555;
      margin: 0 3px;
      text-decoration: auto;
      -webkit-touch-callout: auto;
      font: caption;
    }
    footer a:hover {
      color: #222;
    }
    </style>

</head>
<body>
   <div class="browserName">
       <div class="logo-wrap">
         <span class="brand-main">BrowSify</span><span class="brand-sub">Web</span>
       </div>

       <style>
         .logo-wrap {
           display: inline-block;
           font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
           font-size: 36px;
           letter-spacing: -1.5px;
           padding: 10px;
           user-select: none;
         }

         .brand-main {
          /* color: #2d3436; */
         }

         .brand-sub {
           color: #0984e3;
           margin-left: 2px;
         }
         /*
         .logo-wrap:hover .brand-sub {
           color: #00cec9;
           border-color: #00cec9;
         }*/
       </style>
   </div>
   <div class="search-container">
        <a href="bsw:search" id="searchBox">
            <input type="text" id="search-bar" placeholder="Search or type URL">
        </a>
    </div>
