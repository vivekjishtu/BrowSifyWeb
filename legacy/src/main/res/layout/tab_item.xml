<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tab_background_normal"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/privateLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="@string/action_private"
        android:textAllCaps="true"
        android:textColor="@color/tab_text_color_normal"
        android:textSize="9sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <jp.hazuki.yuzubrowser.ui.widget.FullFillTextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tab_text_color_normal" />

        <ImageView
            android:id="@+id/closeTabButton"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:alpha="0.85"
            android:contentDescription="@string/action_close_tab"
            android:src="@drawable/ic_close_black_24dp"
            android:tint="@color/tab_text_color_normal"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
