<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingEnd="?attr/dialogPreferredPadding"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finish_mes"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginBottom="16dp"
            style="@style/TextAppearance.AppCompat.Subhead" />

        <TextView
            android:id="@+id/sessionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_category_session"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/closeallCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/close_all_tabs" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/privacyHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_category_privacy_mode"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cacheCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_cache" />

        <CheckBox
            android:id="@+id/cookieCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_cookie" />

        <CheckBox
            android:id="@+id/databaseCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_database" />

        <CheckBox
            android:id="@+id/passwordCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_password" />

        <CheckBox
            android:id="@+id/formdataCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_formdata" />

        <CheckBox
            android:id="@+id/faviconCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/clear_favicon" />

        <CheckBox
            android:id="@+id/deleteHistoryCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/delete_history" />

        <CheckBox
            android:id="@+id/deleteSearchQueryCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/delete_search_query" />

        <CheckBox
            android:id="@+id/removeAllGeoPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/remove_geo_permission" />
    </LinearLayout>

</ScrollView>
